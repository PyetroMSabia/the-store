# Chave secreta para assinatura dos tokens de sessão (HMAC-SHA256, mínimo 32 caracteres)
AUTH_SECRET=the-store-segredo-de-autenticacao-super-seguro-2026

# Credenciais do Administrador da Curadoria (semeado automaticamente no banco relacional)
ADMIN_NAME=Curador The Store
ADMIN_EMAIL=thestore@gmail.com
ADMIN_PASSWORD=TheStore2026@

# Caminho do banco relacional SQLite (padrão: data/the-store.db)
# DATABASE_PATH=data/the-store.db

# URL base da aplicação
APP_URL=http://localhost:3000

# IDs de afiliados opcionais (caso queira injetar automaticamente nas URLs limpas)
# AFFILIATE_MERCADOLIVRE=seu-id-ml
# AFFILIATE_SHOPEE=seu-id-shopee
# AFFILIATE_AMAZON=seutag-20
# AFFILIATE_SHEIN=seu-id-shein
# AFFILIATE_ALIEXPRESS=seu-id-ali
# AFFILIATE_MAGALU=seu-id-magalu
# AFFILIATE_CASASBAHIA=seu-id-cb

